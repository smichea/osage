{
  "name": "@osage/sdk",
  "version": "0.1.0",
  "description": "TypeScript client SDK for the osage protocol",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "buf generate ../../spec/proto",
    "build": "npm run generate && tsc -p tsconfig.json",
    "test": "npm run generate && vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
